# ---------------------------------------------------------------
# FinTrust environment configuration
# Copy this file to `.env` and adjust the values for your machine.
# Never commit the real .env file (it is listed in .gitignore).
# ---------------------------------------------------------------

# local | production
APP_ENV=local
# true shows detailed errors in the browser. Must be false in production.
APP_DEBUG=true
APP_NAME=FinTrust
# The URL you open in the browser, with no trailing slash.
#   XAMPP folder install:  http://localhost/fintrust
#   Virtual host install:  http://fintrust.test
APP_URL=http://localhost/fintrust
APP_TIMEZONE=Africa/Lagos

# ---- Database (XAMPP defaults shown) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fintrust
# Use the least-privilege account created in database/create_user.sql,
# not root. (root works for a first test, but don't keep it.)
DB_USERNAME=fintrust_app
DB_PASSWORD=change-me-to-a-long-random-password

# ---- Sessions ----
SESSION_NAME=fintrust_sid
# Minutes of inactivity before a user is logged out.
SESSION_IDLE_MINUTES=15
# true = cookie only sent over HTTPS. Set to true in production.
SESSION_SECURE_COOKIE=false

# ---- Mail ----
# "log" writes emails to storage/mail/ instead of sending them (development).
MAIL_DRIVER=log
MAIL_FROM=no-reply@fintrust.test
